---
import type { Project } from "../data/projects";
import ProjectCard from "./ProjectCard.astro";

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
// A Clínica Plena (única "completed") vira o card de destaque. Se um dia houver
// mais de um projeto concluído, o primeiro do array assume o destaque — a ordem
// do DOM nunca muda, só o tamanho visual via CSS.
const featuredProject = projects.find((project) => project.status === "completed") ?? projects[0];
---

<div class="project-grid">
  {projects.map((project, index) => <ProjectCard project={project} featured={project.id === featuredProject.id} index={index} />)}
</div>

<style>
  /* Mobile: coluna única, ordem do DOM = ordem visual = ordem de leitura/teclado. */
  .project-grid {
    display: grid;
    gap: var(--space-4);
  }

  /* Tablet: grade simples de 2 colunas, todos os cards com o mesmo peso
     visual — a Clínica Plena já se distingue pelo selo "Case em destaque" e
     pelo preview editorial, sem precisar de uma linha inteira só para ela. */
  @media (min-width: 768px) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Desktop largo: grade de 3 colunas iguais — reduz a sensação de "2 cards
     gigantes por linha" e deixa a Clínica Plena, a SaaS e a Consultoria na
     mesma linha (a Clínica se distingue pelo selo/preview, não pelo tamanho
     do grid). A Educação fica sozinha na segunda linha, do mesmo tamanho dos
     demais: esticá-la para preencher a linha deixaria o preview desproporcionalmente
     alto — o oposto do que esta rodada busca. */
  @media (min-width: 1200px) {
    .project-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
