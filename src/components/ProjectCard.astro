---
import type { Project } from "../data/projects";
import ProjectPreview from "./ProjectPreview.astro";
import { withBase } from "../utils/url";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const isCompleted = project.status === "completed";
const detailHref = project.hasDetailPage ? withBase(`projetos/${project.slug}`) : undefined;
const demoHref = project.demoPath ? withBase(project.demoPath) : undefined;
---

<article class:list={["project-card", { "project-card--planned": !isCompleted }]} style={`--accent: ${project.accent};`}>
  <ProjectPreview style={project.previewStyle} accent={project.accent} label={project.name} />

  <div class="project-card__body">
    <div class="project-card__meta">
      <span class:list={["status-badge", isCompleted ? "status-badge--done" : "status-badge--planned"]}>
        {isCompleted ? "Concluído" : "Planejado"}
      </span>
      <span class="project-card__segment">{project.segment}</span>
    </div>

    <h3>{project.name}</h3>
    <p class="project-card__description">{project.description}</p>
    <p class="project-card__goal"><strong>Objetivo:</strong> {project.goal}</p>

    <ul class="tag-list">
      {(isCompleted ? project.highlights : project.stack).map((item) => <li>{item}</li>)}
    </ul>

    {
      isCompleted ? (
        <div class="project-card__actions">
          {demoHref && (
            <a class="text-link" href={demoHref}>
              Ver projeto<span aria-hidden="true">→</span>
            </a>
          )}
          {detailHref && <a class="text-link text-link--muted" href={detailHref}>Ver detalhes</a>}
          {project.codeUrl && (
            <a class="text-link text-link--muted" href={project.codeUrl} target="_blank" rel="noopener noreferrer">
              Código
            </a>
          )}
        </div>
      ) : (
        <p class="project-card__note">Em breve.</p>
      )
    }
  </div>
</article>

<style>
  .project-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    display: grid;
    overflow: hidden;
    transition: transform var(--transition-slow), border-color var(--transition-slow), box-shadow var(--transition-slow);
  }

  .project-card:not(.project-card--planned):hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--color-border-strong));
    box-shadow: var(--shadow-raised);
    transform: translateY(-3px);
  }

  .project-card--planned {
    border-style: dashed;
  }

  .project-card__body {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5);
  }

  .project-card__meta {
    align-items: center;
    display: flex;
    gap: var(--space-3);
    justify-content: space-between;
  }

  .project-card__segment {
    color: var(--color-muted);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .project-card__description,
  .project-card__goal {
    color: var(--color-muted-strong);
  }

  .project-card__goal strong {
    color: var(--color-muted-strong);
  }

  .project-card__actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-1);
  }

  .text-link {
    align-items: center;
    color: var(--accent);
    display: inline-flex;
    font-weight: 800;
    gap: 0.35rem;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.25rem;
  }

  .text-link--muted {
    color: var(--color-muted-strong);
    font-weight: 700;
    text-decoration-color: var(--color-border-strong);
  }

  .project-card__note {
    color: var(--color-muted);
    font-size: 0.85rem;
    font-weight: 700;
    margin-top: var(--space-1);
  }
</style>
