---
import type { Project } from "../data/projects";
import ProjectPreview from "./ProjectPreview.astro";
import { withBase } from "../utils/url";
import { getProjectDetail } from "../data/projectDetails";

interface Props {
  project: Project;
  featured?: boolean;
  /** Posição no grid, usada só para escalonar o delay da animação de entrada. */
  index?: number;
}

const { project, featured = false, index = 0 } = Astro.props;
const isCompleted = project.status === "completed";
const detail = project.hasDetailPage ? getProjectDetail(project.slug) : undefined;
const detailHref = project.hasDetailPage ? withBase(`projetos/${project.slug}`) : undefined;
const demoHref = project.demoPath ? withBase(project.demoPath) : undefined;
const transitionName = project.hasDetailPage ? `project-preview-${project.slug}` : undefined;
const cardStyle = `--accent: ${project.accent}; transition-delay: ${Math.min(index, 4) * 70}ms;`;

// Texto editorial de apoio para projetos planejados. O status semântico e o
// badge continuam sempre "Planejado" — isto só varia a frase complementar.
const plannedNotes: Record<string, string> = {
  "consultoria-empresarial": "Desenvolvimento previsto para uma próxima etapa.",
  "plataforma-preparatoria": "Conceito reservado para a expansão do catálogo."
};
const plannedNote = plannedNotes[project.id] ?? "Planejado para uma próxima etapa da coleção.";
---

<article
  class:list={["project-card", "reveal", { "project-card--planned": !isCompleted, "project-card--featured": featured }]}
  style={cardStyle}
>
  <ProjectPreview
    style={project.previewStyle}
    accent={project.accent}
    label={project.name}
    segment={project.segment}
    transitionName={transitionName}
    slug={project.slug}
    screenshotAlt={detail?.screenshotAlt}
  />

  {
    featured ? (
      // Composição própria do case em destaque: nada de badge + selo soltos —
      // uma única linha editorial ("Concluído · Case em destaque"), uma régua
      // de acento em sálvia e uma hierarquia de ações clara (principal/secundária/terciária).
      <div class="project-card__body project-card__body--featured">
        <div class="project-card__accent-rule" aria-hidden="true" />
        <div class="project-card__content">
          <p class="project-card__eyebrow">Concluído · Case em destaque</p>
          <h3>{project.name}</h3>
          <p class="project-card__description">{project.description}</p>
          <p class="project-card__goal"><strong>Objetivo:</strong> {project.goal}</p>
          <ul class="tag-list tag-list--quiet">
            {project.highlights.slice(0, 2).map((item) => <li>{item}</li>)}
          </ul>
          <div class="project-card__actions">
            {demoHref && (
              // data-astro-reload: navegação completa e não interceptada pelo ClientRouter —
              // saude/ é um documento vanilla independente, fora do roteador do Astro.
              <a class="cta-primary" href={demoHref} data-astro-reload>
                Ver demonstração<span aria-hidden="true">→</span>
              </a>
            )}
            {detailHref && <a class="text-link text-link--muted" href={detailHref}>Ver case</a>}
            {project.codeUrl && (
              <a class="text-link text-link--subtle" href={project.codeUrl} target="_blank" rel="noopener noreferrer">
                Ver código
              </a>
            )}
          </div>
        </div>
      </div>
    ) : (
      <div class="project-card__body">
        <div class="project-card__meta">
          <span class:list={["status-badge", isCompleted ? "status-badge--done" : "status-badge--planned"]}>
            {isCompleted ? "Concluído" : "Planejado"}
          </span>
          <span class="project-card__segment">{project.segment}</span>
        </div>

        <h3>{project.name}</h3>
        <p class="project-card__description">{project.description}</p>

        {
          isCompleted ? (
            <>
              <p class="project-card__goal"><strong>Objetivo:</strong> {project.goal}</p>
              <ul class="tag-list">
                {project.highlights.slice(0, 2).map((item) => <li>{item}</li>)}
              </ul>
              <div class="project-card__actions">
                {demoHref && (
                  <a class="text-link" href={demoHref} data-astro-reload>
                    Ver demonstração<span aria-hidden="true">→</span>
                  </a>
                )}
                {detailHref && <a class="text-link text-link--muted" href={detailHref}>Ver case</a>}
                {project.codeUrl && (
                  <a class="text-link text-link--subtle" href={project.codeUrl} target="_blank" rel="noopener noreferrer">
                    Ver código
                  </a>
                )}
              </div>
            </>
          ) : (
            <>
              <p class="project-card__label">Destaques previstos</p>
              <ul class="tag-list">
                {project.highlights.slice(0, 2).map((item) => <li>{item}</li>)}
              </ul>
              <p class="project-card__stack">Stack prevista: {project.stack.join(", ")}</p>
              <p class="project-card__note">{plannedNote}</p>
            </>
          )
        }
      </div>
    )
  }
</article>

<style>
  .project-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    display: grid;
    overflow: hidden;
    /* opacity/transform aqui (em vez de só no .reveal global) porque esta regra,
       sendo do componente, tem especificidade maior e sobrescreveria o timing da
       entrada — precisa incluir os dois para a animação de entrada ficar suave. */
    transition: transform var(--transition-slow), border-color var(--transition-slow), box-shadow var(--transition-slow),
      opacity var(--transition-slow);
  }

  .project-card:not(.project-card--planned):hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--color-border-strong));
    box-shadow: var(--shadow-raised);
    transform: translateY(-3px);
  }

  .project-card--planned {
    border-style: dashed;
  }

  /* Acabamento exclusivo do case em destaque: borda com um leve tom do
     acento do projeto e sombra em duas camadas (contato + ambiente) para dar
     profundidade sem virar glow — a cor da sombra continua neutra, só a
     borda recebe o acento. */
  .project-card--featured {
    border-color: color-mix(in srgb, var(--accent) 24%, var(--color-border-strong));
    box-shadow: var(--shadow-card), 0 24px 44px -28px rgba(0, 0, 0, 0.55);
  }

  .project-card__body {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4);
  }

  /* Composição do case em destaque: régua vertical em sálvia (o "acento
     visual exclusivo") ao lado de um único bloco de conteúdo — menos "ficha
     técnica empilhada", mais coluna editorial única. */
  .project-card__body--featured {
    column-gap: var(--space-4);
    display: grid;
    grid-template-columns: 3px 1fr;
    padding: var(--space-5);
  }

  .project-card__accent-rule {
    background: var(--accent);
    border-radius: 999px;
  }

  .project-card__content {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
  }

  .project-card__content h3 {
    font-size: 1.55rem;
  }

  .project-card__eyebrow {
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Descrição e objetivo ficam mais discretos no destaque — apoio ao nome,
     não conteúdo em pé de igualdade com ele. */
  .project-card__content .project-card__description {
    color: var(--color-muted);
    font-size: 0.92rem;
  }

  .project-card__content .project-card__goal {
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  /* Tags como apoio silencioso: legenda com separador, igual à composição
     do preview — não competem visualmente com nome/descrição/ação. */
  .tag-list--quiet {
    color: var(--color-muted);
    display: block;
    font-size: 0.78rem;
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tag-list--quiet li {
    background: none;
    border: 0;
    border-radius: 0;
    color: inherit;
    display: inline;
    padding: 0;
  }

  .tag-list--quiet li:not(:last-child)::after {
    color: var(--color-border-strong);
    content: "·";
    margin: 0 0.45em;
  }

  /* CTA principal do destaque: botão editorial (fundo leve + borda), não um
     botão sólido pesado — mas visivelmente mais forte que os links ao lado. */
  .cta-primary {
    align-items: center;
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 38%, transparent);
    border-radius: var(--radius-sm);
    color: var(--accent);
    display: inline-flex;
    font-weight: 800;
    gap: 0.35rem;
    padding: 0.5rem 0.9rem;
    text-decoration: none;
    transition: background var(--transition), border-color var(--transition), transform var(--transition);
  }

  .cta-primary:hover {
    background: color-mix(in srgb, var(--accent) 22%, transparent);
    border-color: var(--accent);
    transform: translateY(-1px);
  }

  .tag-list {
    gap: var(--space-1);
  }

  .tag-list li {
    font-size: 0.76rem;
    padding: 0.22rem 0.6rem;
  }

  .project-card__label {
    color: var(--color-muted);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .project-card__stack {
    color: var(--color-muted);
    font-size: 0.8rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .project-card__meta {
    align-items: center;
    display: flex;
    gap: var(--space-3);
    justify-content: space-between;
  }

  .project-card__segment {
    color: var(--color-muted);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .project-card__description,
  .project-card__goal {
    color: var(--color-muted-strong);
  }

  .project-card__description {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  .project-card__goal {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .project-card__goal strong {
    color: var(--color-muted-strong);
  }

  .project-card__actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-1);
  }

  .text-link {
    align-items: center;
    color: var(--accent);
    display: inline-flex;
    font-weight: 800;
    gap: 0.35rem;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.25rem;
  }

  .text-link--muted {
    color: var(--color-muted-strong);
    font-weight: 700;
    text-decoration-color: var(--color-border-strong);
  }

  /* Ação terciária: mesma família visual, mais discreta — sem negrito extra,
     um tom mais claro e sublinhado só ao focar/passar o mouse. */
  .text-link--subtle {
    color: var(--color-muted);
    font-size: 0.9em;
    font-weight: 600;
    text-decoration-color: transparent;
    transition: text-decoration-color var(--transition), color var(--transition);
  }

  .text-link--subtle:hover,
  .text-link--subtle:focus-visible {
    color: var(--color-muted-strong);
    text-decoration-color: var(--color-border-strong);
  }

  .project-card__note {
    color: var(--color-muted);
    font-size: 0.85rem;
    font-weight: 700;
    margin-top: var(--space-1);
  }
</style>
