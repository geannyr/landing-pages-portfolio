---
import type { PreviewStyle } from "../data/projects";
import { hasProjectScreenshot, projectScreenshotUrl } from "../utils/screenshot";

interface Props {
  style: PreviewStyle;
  accent: string;
  label: string;
  segment: string;
  /** Nome da View Transition (astro:transitions) para casar com o mesmo preview na página de detalhes. Omitido = sem transição nomeada. */
  transitionName?: string;
  /** slug do projeto — usado para procurar public/images/projects/{slug}-preview.webp. */
  slug?: string;
  /** Obrigatório para renderizar a imagem real (sem alt não há <img>, só o fallback). */
  screenshotAlt?: string;
}

const { style, accent, label, segment, transitionName, slug, screenshotAlt } = Astro.props;
const hasScreenshot = Boolean(slug && screenshotAlt && hasProjectScreenshot(slug));
const screenshotUrl = hasScreenshot && slug ? projectScreenshotUrl(slug) : undefined;
// Clínica Plena é o único projeto concluído do catálogo: em vez do fallback
// abstrato genérico, recebe uma composição própria inspirada na landing real
// (saude/) enquanto não houver uma captura de tela de verdade.
const isClinicaPlena = !hasScreenshot && slug === "clinica-plena";
// Fluxa também recebe uma composição própria enquanto não houver screenshot
// real: pipeline de vendas em miniatura (a assinatura visual aprovada da
// landing), em vez do fallback abstrato genérico de "dashboard".
const isFluxa = !hasScreenshot && slug === "fluxa";
---

<div
  class:list={["preview", { "preview--clinica": isClinicaPlena, "preview--fluxa": isFluxa }]}
  style={`--accent: ${accent};`}
  aria-hidden={hasScreenshot ? undefined : "true"}
  transition:name={transitionName}
>
  {
    hasScreenshot && screenshotUrl ? (
      <img
        class="preview__image"
        src={screenshotUrl}
        width="1280"
        height="800"
        alt={screenshotAlt}
        loading="lazy"
        decoding="async"
      />
    ) : !isClinicaPlena && !isFluxa ? (
      <>
        <div class="preview__texture" aria-hidden="true" />
        <span class="preview__window" aria-hidden="true"><span></span><span></span><span></span></span>
      </>
    ) : null
  }

  {
    isClinicaPlena && (
      <div class="preview__body preview__body--clinica">
        <div class="cp-topbar">
          <span class="cp-mark">CP</span>
          <span class="cp-brand">Clínica Plena</span>
        </div>
        <div class="cp-main">
          <div class="cp-copy">
            <p class="cp-headline">Cuidado integrado para viver com mais equilíbrio.</p>
            <ul class="cp-tags">
              <li>Psicologia</li>
              <li>Nutrição</li>
              <li>Fisioterapia</li>
            </ul>
          </div>
          <div class="cp-panel">
            <span class="cp-panel__blob" />
            <span class="cp-panel__blob-sage" />
            <span class="cp-panel__dot" />
            <div class="cp-panel__card">
              <span class="cp-panel__label">Plano de cuidado</span>
              <span class="cp-panel__rule" />
            </div>
          </div>
        </div>
      </div>
    )
  }

  {
    isFluxa && (
      <div class="preview__body preview__body--fluxa">
        <div class="fx-topbar">
          <span class="fx-mark">F</span>
          <span class="fx-brand">Fluxa</span>
        </div>
        <div class="fx-pipeline">
          <div class="fx-col">
            <span class="fx-col-title">Novo</span>
            <span class="fx-card" />
          </div>
          <div class="fx-col">
            <span class="fx-col-title">Conversa</span>
            <span class="fx-card" />
          </div>
          <div class="fx-col">
            <span class="fx-col-title">Proposta</span>
            <span class="fx-card" />
          </div>
          <div class="fx-col">
            <span class="fx-col-title">Fechado</span>
            <span class="fx-card fx-card--won" />
          </div>
        </div>
      </div>
    )
  }

  {
    !hasScreenshot && !isClinicaPlena && !isFluxa && style === "screenshot" && (
      <div class="preview__body preview__body--screenshot">
        <div class="preview__site-bar">
          <span class="preview__site-mark" />
          <span class="preview__site-line" />
        </div>
        <div class="preview__site-hero">
          <span class="preview__site-title" />
          <span class="preview__site-title preview__site-title--short" />
        </div>
        <div class="preview__site-tags">
          <span />
          <span />
          <span />
        </div>
        <span class="preview__site-cta" />
        <span class="preview__note">{label} — preview em breve</span>
      </div>
    )
  }

  {
    !hasScreenshot && style === "dashboard" && !isFluxa && (
      <div class="preview__body preview__body--dashboard">
        <div class="preview__sidebar">
          <span />
          <span />
          <span />
        </div>
        <div class="preview__main">
          <div class="preview__stat-row">
            <div class="preview__stat" />
            <div class="preview__stat" />
            <div class="preview__stat" />
          </div>
          <div class="preview__chart">
            <span style="height: 35%" /><span style="height: 68%" /><span style="height: 48%" /><span style="height: 82%" /><span style="height: 58%" /><span style="height: 90%" />
          </div>
        </div>
      </div>
    )
  }

  {
    !hasScreenshot && style === "editorial" && (
      <div class="preview__body preview__body--editorial">
        <span class="preview__monogram" />
        <div class="preview__block preview__block--title" />
        <div class="preview__block" />
        <div class="preview__block preview__block--short" />
        <div class="preview__rule" />
        <div class="preview__columns">
          <div class="preview__block" />
          <div class="preview__block preview__block--short" />
          <div class="preview__block" />
        </div>
      </div>
    )
  }

  {
    !hasScreenshot && style === "course" && (
      <div class="preview__body preview__body--course">
        <div class="preview__course-row">
          <div class="preview__course-card"><span /></div>
          <div class="preview__course-card"><span /></div>
        </div>
        <div class="preview__progress">
          <span></span>
        </div>
      </div>
    )
  }

  <span class="preview__segment" aria-hidden="true">{segment}</span>
</div>

<style>
  .preview {
    aspect-ratio: 16 / 7.5;
    background: linear-gradient(160deg, color-mix(in srgb, var(--accent) 22%, var(--color-surface-raised)), var(--color-surface) 85%);
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
    position: relative;
  }

  .preview__image {
    aspect-ratio: 16 / 7.5;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .preview__texture {
    background-image: radial-gradient(color-mix(in srgb, var(--color-text) 14%, transparent) 1px, transparent 1px);
    background-size: 14px 14px;
    inset: 0;
    opacity: 0.35;
    position: absolute;
  }

  .preview__window {
    display: flex;
    gap: 0.3rem;
    left: var(--space-4);
    position: absolute;
    top: var(--space-4);
    z-index: 1;
  }

  .preview__window span {
    background: var(--accent);
    border-radius: 999px;
    display: block;
    height: 0.45rem;
    opacity: 0.7;
    width: 0.45rem;
  }

  .preview__segment {
    background: color-mix(in srgb, var(--color-bg) 55%, transparent);
    border-radius: 999px;
    bottom: var(--space-3);
    color: var(--color-text);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    position: absolute;
    right: var(--space-3);
    z-index: 1;
  }

  .preview__body {
    height: 100%;
    padding: var(--space-4) var(--space-5) var(--space-3);
    position: relative;
    width: 100%;
    z-index: 1;
  }

  /* screenshot */
  .preview__body--screenshot {
    display: grid;
    gap: var(--space-2);
  }

  .preview__site-bar {
    align-items: center;
    display: flex;
    gap: var(--space-2);
  }

  .preview__site-mark {
    background: var(--accent);
    border-radius: 999px;
    height: 0.9rem;
    width: 0.9rem;
  }

  .preview__site-line {
    background: color-mix(in srgb, var(--color-text) 20%, transparent);
    border-radius: 999px;
    height: 0.4rem;
    width: 40%;
  }

  .preview__site-hero {
    display: grid;
    gap: var(--space-1);
    margin-top: var(--space-1);
  }

  .preview__site-title {
    background: color-mix(in srgb, var(--color-text) 30%, transparent);
    border-radius: var(--radius-sm);
    height: 0.85rem;
    width: 80%;
  }

  .preview__site-title--short {
    width: 55%;
  }

  .preview__site-tags {
    display: flex;
    gap: var(--space-2);
  }

  .preview__site-tags span {
    background: color-mix(in srgb, var(--accent) 30%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 50%, transparent);
    border-radius: 999px;
    height: 0.9rem;
    width: 22%;
  }

  .preview__site-cta {
    background: var(--accent);
    border-radius: var(--radius-sm);
    height: 1.3rem;
    margin-top: var(--space-1);
    width: 34%;
  }

  .preview__note {
    color: var(--color-muted-strong);
    font-size: 0.72rem;
    font-weight: 700;
    margin-top: auto;
  }

  /* dashboard */
  .preview__body--dashboard {
    display: grid;
    gap: var(--space-2);
    grid-template-columns: 24% 1fr;
    height: 100%;
  }

  .preview__sidebar {
    background: color-mix(in srgb, var(--accent) 28%, var(--color-surface-raised));
    border-radius: var(--radius-sm);
    display: grid;
    align-content: start;
    gap: var(--space-1);
    padding: var(--space-2);
  }

  .preview__sidebar span {
    background: color-mix(in srgb, var(--color-text) 35%, transparent);
    border-radius: 999px;
    height: 0.35rem;
    width: 100%;
  }

  .preview__main {
    display: grid;
    gap: var(--space-1);
    grid-template-rows: auto 1fr;
  }

  .preview__stat-row {
    display: flex;
    gap: var(--space-1);
  }

  .preview__stat {
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    height: 1.3rem;
    flex: 1;
  }

  .preview__chart {
    align-items: flex-end;
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    display: flex;
    gap: var(--space-1);
    padding: var(--space-2);
  }

  .preview__chart span {
    background: var(--accent);
    border-radius: 999px 999px 0 0;
    flex: 1;
    opacity: 0.85;
  }

  /* editorial */
  .preview__body--editorial {
    display: grid;
    gap: var(--space-1);
  }

  .preview__monogram {
    background: color-mix(in srgb, var(--accent) 45%, var(--color-surface-raised));
    border-radius: 999px;
    height: 1.3rem;
    margin-bottom: 0;
    width: 1.3rem;
  }

  .preview__block {
    background: color-mix(in srgb, var(--color-text) 16%, var(--color-surface-raised));
    border-radius: var(--radius-sm);
    height: 0.7rem;
    width: 100%;
  }

  .preview__block--title {
    background: color-mix(in srgb, var(--accent) 45%, var(--color-surface-raised));
    height: 1.1rem;
    width: 65%;
  }

  .preview__block--short {
    width: 55%;
  }

  .preview__rule {
    background: var(--color-border);
    height: 1px;
    margin: 2px 0;
    width: 100%;
  }

  .preview__columns {
    display: grid;
    gap: var(--space-1);
    grid-template-columns: repeat(3, 1fr);
  }

  /* course */
  .preview__body--course {
    display: grid;
    gap: var(--space-2);
    grid-template-rows: 1fr auto;
    height: 100%;
  }

  .preview__course-row {
    display: grid;
    gap: var(--space-2);
    grid-template-columns: repeat(2, 1fr);
  }

  .preview__course-card {
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    display: grid;
    align-content: start;
    padding: var(--space-2);
  }

  .preview__course-card span {
    background: color-mix(in srgb, var(--accent) 40%, transparent);
    border-radius: var(--radius-sm);
    height: 60%;
    width: 60%;
  }

  .preview__progress {
    background: var(--color-surface-raised);
    border-radius: 999px;
    height: 0.6rem;
    overflow: hidden;
  }

  .preview__progress span {
    background: var(--accent);
    display: block;
    height: 100%;
    width: 62%;
  }

  /* Clínica Plena — interpretação visual (não importada) da paleta e da
     composição de saude/: creme quente, sálvia profunda, terracota discreta
     e título serifado. Escala só com rem/% para caber de 320 a 1920px. */
  .preview--clinica {
    --cp-bg: #fbf7f0;
    --cp-bg-alt: #f3ede2;
    --cp-sage: #4a6558;
    --cp-sage-dark: #2c4038;
    --cp-terracotta: #c98168;
    --cp-ink: #2b2a26;
    --cp-muted: #6b6558;
    background: linear-gradient(160deg, var(--cp-bg) 0%, var(--cp-bg-alt) 100%);
    /* Borda/sombra próprias, mais quentes que o preview genérico — refinamento,
       não glow: o anel é neutro/interno, só a linha inferior recebe terracota. */
    border-bottom-color: color-mix(in srgb, var(--cp-terracotta) 32%, var(--color-border));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--cp-sage-dark) 7%, transparent);
    container-type: inline-size;
  }

  /* Textura de papel muito sutil — só perceptível de perto, reforça o ar
     editorial sem competir com o conteúdo. */
  .preview--clinica::before {
    background-image: radial-gradient(color-mix(in srgb, var(--cp-sage-dark) 12%, transparent) 1px, transparent 1px);
    background-size: 9px 9px;
    content: "";
    inset: 0;
    opacity: 0.4;
    position: absolute;
  }

  .preview__body--clinica {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: var(--space-3);
  }

  .cp-topbar {
    align-items: center;
    display: flex;
    gap: 0.4rem;
  }

  .cp-mark {
    align-items: center;
    background: var(--cp-sage-dark);
    border-radius: 999px;
    color: var(--cp-bg);
    display: flex;
    flex-shrink: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 0.5rem;
    font-weight: 700;
    height: 0.95rem;
    justify-content: center;
    width: 0.95rem;
  }

  .cp-brand {
    color: var(--cp-sage-dark);
    font-size: 0.55rem;
    font-weight: 700;
  }

  .cp-main {
    display: flex;
    flex: 1;
    gap: 0.75rem;
    min-height: 0;
  }

  .cp-copy {
    display: flex;
    flex: 1.55;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }

  /* Headline com mais presença tipográfica, mas em coluna mais estreita —
     não atravessa a miniatura, lê como um recorte de manchete de hero, não
     como uma faixa de texto esticada de ponta a ponta. */
  .cp-headline {
    color: var(--cp-sage-dark);
    display: -webkit-box;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(0.9rem, 6.6cqi, 1.28rem);
    font-weight: 700;
    letter-spacing: -0.018em;
    line-height: 1.1;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  /* Especialidades tratadas como assinatura discreta, não conteúdo — o menor
     elemento de texto da composição. */
  .cp-tags {
    color: color-mix(in srgb, var(--cp-muted) 78%, transparent);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.4rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    list-style: none;
    margin: 0;
    margin-top: auto;
    padding: 0;
    text-transform: uppercase;
  }

  .cp-tags li {
    background: none;
    border: 0;
    border-radius: 0;
    color: inherit;
    padding: 0;
  }

  .cp-tags li:not(:last-child)::after {
    color: color-mix(in srgb, var(--cp-terracotta) 70%, transparent);
    content: "·";
    margin: 0 0.3em;
  }

  /* Composição direita: o cartão fica ancorado no canto inferior, as formas
     orgânicas nascem atrás dele e se estendem para além das bordas — nada de
     card branco flutuando isolado no centro. */
  .cp-panel {
    align-items: flex-end;
    display: flex;
    flex: 0.85;
    justify-content: flex-end;
    min-width: 0;
    padding: 6% 2% 2% 4%;
    position: relative;
  }

  /* Três camadas orgânicas com tamanho/tom diferentes (terracota grande,
     sálvia média, terracota pequena) — profundidade por sobreposição e
     variação tonal, sem blur nem glow. */
  .cp-panel__blob {
    background: color-mix(in srgb, var(--cp-terracotta) 60%, transparent);
    border-radius: 42% 58% 55% 45% / 48% 42% 58% 52%;
    height: 72%;
    opacity: 0.24;
    position: absolute;
    right: 6%;
    top: -2%;
    transition: transform var(--transition-slow, 250ms ease);
    width: 72%;
  }

  .cp-panel__blob-sage {
    background: color-mix(in srgb, var(--cp-sage) 58%, transparent);
    border-radius: 56% 44% 40% 60% / 44% 56% 44% 56%;
    bottom: 2%;
    height: 42%;
    left: 0%;
    opacity: 0.3;
    position: absolute;
    transition: transform var(--transition-slow, 250ms ease);
    width: 42%;
  }

  .cp-panel__dot {
    background: color-mix(in srgb, var(--cp-terracotta) 85%, transparent);
    border-radius: 44% 56% 48% 52% / 56% 44% 56% 44%;
    bottom: 34%;
    height: 11%;
    position: absolute;
    right: 0%;
    width: 11%;
  }

  /* O cartão em si — pequeno, com sombra leve e borda interna quase
     imperceptível, sobrepondo parcialmente as formas atrás dele. */
  .cp-panel__card {
    background: #fffdf9;
    border: 1px solid color-mix(in srgb, var(--cp-sage-dark) 8%, transparent);
    border-radius: var(--radius-sm);
    box-shadow: 0 0.35rem 0.75rem rgba(43, 42, 38, 0.1);
    padding: 0.4rem 0.45rem;
    position: relative;
    transition: transform var(--transition-slow, 250ms ease);
    width: 68%;
    z-index: 1;
  }

  .cp-panel__label {
    color: var(--cp-sage-dark);
    display: -webkit-box;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(0.42rem, 3.2cqi, 0.48rem);
    font-weight: 700;
    line-height: 1.2;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  .cp-panel__rule {
    background: var(--cp-terracotta);
    border-radius: 999px;
    display: block;
    height: 2px;
    margin-top: 0.3rem;
    width: 50%;
  }

  .preview--clinica:hover .cp-panel__card {
    transform: translateY(-2px);
  }

  .preview--clinica:hover .cp-panel__blob {
    transform: translate(2px, -2px);
  }

  .preview--clinica:hover .cp-panel__blob-sage {
    transform: translate(-1px, 1px);
  }

  @media (prefers-reduced-motion: reduce) {
    .cp-panel__card,
    .cp-panel__blob,
    .cp-panel__blob-sage {
      transition: none;
    }

    .preview--clinica:hover .cp-panel__card,
    .preview--clinica:hover .cp-panel__blob,
    .preview--clinica:hover .cp-panel__blob-sage {
      transform: none;
    }
  }

  /* Fluxa — interpretação visual (não importada de saas/) da identidade
     aprovada da landing: off-white/grafite com acento índigo, sem serif e
     sem formas orgânicas. O pipeline de vendas é a assinatura visual, então
     é o que este preview reproduz em miniatura — não um dashboard genérico. */
  .preview--fluxa {
    --fx-bg: #f6f7fc;
    --fx-bg-alt: #ececf6;
    --fx-indigo: #4c5fd7;
    --fx-indigo-dark: #333f9e;
    --fx-ink: #14172b;
    --fx-muted: #5b5f76;
    --fx-positive: #007656;
    --fx-positive-soft: #dcf3ec;
    background: linear-gradient(160deg, var(--fx-bg) 0%, var(--fx-bg-alt) 100%);
    border-bottom-color: color-mix(in srgb, var(--fx-indigo) 30%, var(--color-border));
    container-type: inline-size;
  }

  .preview__body--fluxa {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: var(--space-3);
  }

  .fx-topbar {
    align-items: center;
    display: flex;
    gap: 0.4rem;
  }

  .fx-mark {
    align-items: center;
    background: var(--fx-indigo);
    border-radius: 0.2rem;
    color: #fff;
    display: flex;
    flex-shrink: 0;
    font-size: 0.5rem;
    font-weight: 800;
    height: 0.95rem;
    justify-content: center;
    width: 0.95rem;
  }

  .fx-brand {
    color: var(--fx-ink);
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .fx-pipeline {
    display: grid;
    flex: 1;
    gap: 0.4rem;
    grid-template-columns: repeat(4, 1fr);
    min-height: 0;
  }

  .fx-col {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .fx-col-title {
    color: var(--fx-muted);
    font-size: clamp(0.34rem, 2.6cqi, 0.42rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    overflow: hidden;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .fx-card {
    background: #fff;
    border: 1px solid color-mix(in srgb, var(--fx-indigo-dark) 12%, transparent);
    border-radius: 0.2rem;
    box-shadow: 0 0.2rem 0.4rem rgba(20, 23, 43, 0.06);
    display: block;
    flex: 1;
    min-height: 0.9rem;
  }

  .fx-card--won {
    background: var(--fx-positive-soft);
    border-color: transparent;
    border-bottom: 2px solid var(--fx-positive);
