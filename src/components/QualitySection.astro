---
const criteria = [
  { title: "Responsividade", text: "Testado de 320px a telas grandes, sem overflow." },
  { title: "Acessibilidade", text: "Semântica, teclado, contraste AA e estados claros." },
  { title: "SEO", text: "Metadados, URLs semânticas e sitemap por página." },
  { title: "Performance", text: "Geração estática e JavaScript mínimo." },
  { title: "Código organizado", text: "Componentes pequenos e dados centralizados." },
  { title: "Experiência de conversão", text: "Hierarquia clara e ações explícitas." }
];
---

<section class="section" id="qualidade" aria-labelledby="qualidade-title">
  <div class="container">
    <div class="section-heading reveal">
      <p class="eyebrow">Critérios de qualidade</p>
      <h2 id="qualidade-title">Padrões que valem para todos os projetos.</h2>
    </div>

    <ul class="quality-list">
      {
        criteria.map((item) => (
          <li class="quality-item">
            <strong>{item.title}</strong>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .quality-list {
    border-top: 1px solid var(--color-border);
    display: grid;
    list-style: none;
  }

  .quality-item {
    border-bottom: 1px solid var(--color-border);
    display: grid;
    gap: 0.2rem;
    padding: var(--space-4) 0;
  }

  .quality-item strong {
    align-items: center;
    color: var(--color-text);
    display: flex;
    gap: var(--space-2);
  }

  /* Marcador por cor, sempre acompanhado do texto do título — nunca é o único
     indicador de nada (o título continua sendo lido normalmente por leitor de tela). */
  .quality-item strong::before {
    background: var(--color-accent);
    border-radius: 999px;
    content: "";
    flex-shrink: 0;
    height: 0.4rem;
    width: 0.4rem;
  }

  .quality-item:nth-child(3n + 2) strong::before {
    background: var(--color-accent-alt);
  }

  .quality-item p {
    color: var(--color-muted);
    margin-left: calc(0.4rem + var(--space-2));
  }

  @media (min-width: 768px) {
    .quality-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .quality-item:nth-child(odd) {
      border-right: 1px solid var(--color-border);
      padding-right: var(--space-5);
    }

    .quality-item:nth-child(even) {
      padding-left: var(--space-5);
    }
  }
</style>
