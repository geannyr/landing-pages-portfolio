---
const steps = [
  { title: "Estratégia e conteúdo", text: "Definição do segmento, objetivo e mensagem principal do projeto." },
  { title: "Arquitetura da informação", text: "Organização das seções e hierarquia de conteúdo." },
  { title: "Direção visual", text: "Identidade, paleta e composição visual coerentes com o objetivo." },
  { title: "Desenvolvimento", text: "Implementação semântica, responsiva e com JavaScript mínimo." },
  { title: "Acessibilidade", text: "Teclado, contraste, leitura por tecnologia assistiva e estados claros." },
  { title: "Validação", text: "Revisão de responsividade, performance e ausência de links falsos." }
];
---

<section class="section section--alt" id="processo" aria-labelledby="processo-title">
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow">Processo</p>
      <h2 id="processo-title">Como cada projeto é construído.</h2>
    </div>

    <ol class="timeline">
      {
        steps.map((step, index) => (
          <li class="timeline__item">
            <span class="timeline__index">{index + 1}</span>
            <div>
              <strong>{step.title}</strong>
              <p>{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .timeline {
    display: grid;
    gap: var(--space-4);
    list-style: none;
  }

  .timeline__item {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    display: grid;
    gap: var(--space-3);
    grid-template-columns: auto 1fr;
    padding: var(--space-5);
  }

  .timeline__index {
    align-items: center;
    background: color-mix(in srgb, var(--color-accent) 20%, transparent);
    border-radius: 999px;
    color: var(--color-accent-strong);
    display: inline-flex;
    font-weight: 800;
    height: 2.25rem;
    justify-content: center;
    width: 2.25rem;
  }

  .timeline__item strong {
    color: var(--color-text);
  }

  .timeline__item p {
    color: var(--color-muted);
    margin-top: var(--space-1);
  }

  @media (min-width: 768px) {
    .timeline {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .timeline {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
