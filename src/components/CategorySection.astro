---
import type { Project } from "../data/projects";
import ProjectGrid from "./ProjectGrid.astro";

interface Props {
  category: string;
  description: string;
  projects: Project[];
}

const { category, description, projects } = Astro.props;
const count = projects.length;
const countLabel = `${count} ${count === 1 ? "projeto" : "projetos"}`;
---

<section class="section" id="projetos" aria-labelledby="projetos-title">
  <div class="container">
    <div class="section-heading reveal">
      <p class="eyebrow">Projetos</p>
      <h2 id="projetos-title">Cada projeto é um estudo completo, do conceito ao código.</h2>
      <div class="category-heading">
        <span class="category-tag">{category}</span>
        <span class="category-count">{countLabel}</span>
      </div>
      <p>{description}</p>
    </div>

    <ProjectGrid projects={projects} />
  </div>
</section>

<style>
  /* Só reduz o respiro do cabeçalho desta seção (escopo do componente via
     Astro) — .section-heading continua com o valor global nas outras seções. */
  .section-heading {
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .category-heading {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .category-tag {
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-muted-strong);
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.3rem 0.75rem;
  }

  .category-count {
    color: var(--color-muted);
    font-size: 0.85rem;
    font-weight: 700;
  }
</style>
