---
import { withBase } from "../utils/url";
import { profile } from "../data/profile";

const home = withBase("");
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <strong>Landing Lab</strong>
      <p>Coleção de projetos front-end criada por Geanny Rodrigues.</p>
      <p class="footer-fineprint">Os projetos apresentados são fictícios e desenvolvidos para fins de portfólio.</p>
    </div>
    <nav aria-label="Links do rodapé">
      <a href={`${home}#projetos`}>Projetos</a>
      <a href={`${home}#processo`}>Processo</a>
      <a href={`${home}#qualidade`}>Qualidade</a>
      <a href={`${home}#contato`}>Contato</a>
    </nav>
    <div class="footer-contact">
      {/* GitHub, LinkedIn e e-mail são valores fixos e sempre preenchidos em
         profile.ts — renderizados como links reais diretamente, sem depender do
         mecanismo de ativação em runtime (contact-links.ts), que existe para
         campos genuinamente opcionais como website/repositoryUrl. */}
      <a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href={profile.email}>E-mail</a>
      {profile.website && <a data-contact="website" aria-disabled="true">Portfólio pessoal</a>}
    </div>
    <p class="footer-meta">&copy; <span id="current-year">2026</span> Geanny Rodrigues</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-bg-alt);
    border-top: 1px solid var(--color-border);
    color: var(--color-muted-strong);
    padding: var(--space-8) 0 var(--space-7);
  }

  .footer-grid {
    display: grid;
    gap: var(--space-6);
  }

  .site-footer strong {
    color: var(--color-text);
  }

  .site-footer p {
    color: var(--color-muted);
    margin-top: var(--space-2);
  }

  .footer-fineprint {
    font-size: 0.82rem;
    margin-top: var(--space-1);
  }

  .site-footer nav,
  .footer-contact {
    display: grid;
    gap: var(--space-2);
  }

  .site-footer a {
    color: var(--color-muted-strong);
    display: inline-block;
    min-height: 2.25rem;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 0.25rem;
    transition: color var(--transition);
  }

  .site-footer a:hover,
  .site-footer a:focus-visible {
    color: var(--color-accent);
  }

  .footer-meta {
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 1.4fr 0.8fr 0.8fr 1fr;
    }

    .footer-meta {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  const yearElement = document.querySelector("#current-year");

  if (yearElement) {
    yearElement.textContent = String(new Date().getFullYear());
  }
</script>
