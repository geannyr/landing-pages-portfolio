---
import { withBase } from "../utils/url";

const home = withBase("");
---

<header class="site-header">
  <div class="container header">
    <a class="brand" href={home} aria-label="Landing Lab, início">
      <span class="brand__mark" aria-hidden="true">GR<span class="brand__mark-dot">.</span></span>
      <span class="brand__name">Landing Lab</span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="nav-toggle__icon" aria-hidden="true"></span>
      <span class="sr-only">Abrir menu de navegação</span>
    </button>

    <nav class="site-nav" id="site-nav" aria-label="Navegação principal">
      <a href={`${home}#projetos`}>Projetos</a>
      <a href={`${home}#processo`}>Processo</a>
      <a href={`${home}#qualidade`}>Qualidade</a>
      <a href={`${home}#contato`}>Contato</a>
      <a class="button button--small button--secondary" data-contact="github" aria-disabled="true">GitHub</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    border-bottom: 1px solid var(--color-border);
    min-height: var(--header-height);
    position: sticky;
    top: 0;
    z-index: 40;
  }

  .header {
    align-items: center;
    display: flex;
    justify-content: space-between;
    min-height: var(--header-height);
  }

  .brand {
    align-items: center;
    color: var(--color-text);
    display: inline-flex;
    gap: var(--space-2);
    text-decoration: none;
  }

  .brand__mark {
    align-items: center;
    background: var(--color-accent);
    border-radius: 999px;
    color: var(--color-on-accent);
    display: inline-flex;
    font-size: 0.85rem;
    font-weight: 700;
    height: 2.25rem;
    justify-content: center;
    letter-spacing: 0;
    width: 2.25rem;
  }

  .brand__mark-dot {
    color: color-mix(in srgb, var(--color-on-accent) 55%, transparent);
  }

  .brand__name {
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .nav-toggle {
    align-items: center;
    background: var(--color-surface);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    display: inline-flex;
    height: 2.6rem;
    justify-content: center;
    width: 2.6rem;
  }

  .nav-toggle__icon,
  .nav-toggle__icon::before,
  .nav-toggle__icon::after {
    background: var(--color-text);
    border-radius: 999px;
    content: "";
    display: block;
    height: 2px;
    position: relative;
    transition: transform var(--transition);
    width: 1.2rem;
  }

  .nav-toggle__icon::before {
    position: absolute;
    top: -6px;
  }

  .nav-toggle__icon::after {
    position: absolute;
    top: 6px;
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle__icon {
    background: transparent;
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle__icon::before {
    transform: translateY(6px) rotate(45deg);
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle__icon::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  .site-nav {
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    display: grid;
    gap: var(--space-2);
    left: 0;
    padding: var(--space-4) var(--space-5) var(--space-5);
    position: fixed;
    right: 0;
    top: var(--header-height);
    transform: translateY(-120%);
    transition: transform var(--transition);
    visibility: hidden;
    z-index: 30;
  }

  .site-nav.is-open {
    transform: translateY(0);
    visibility: visible;
  }

  .site-nav a {
    border-radius: var(--radius-sm);
    color: var(--color-text);
    min-height: 2.75rem;
    padding: var(--space-3);
    text-decoration: none;
  }

  @media (min-width: 1024px) {
    .nav-toggle {
      display: none;
    }

    .site-nav {
      align-items: center;
      background: transparent;
      border: 0;
      display: flex;
      gap: var(--space-2);
      padding: 0;
      position: static;
      transform: none;
      transition: none;
      visibility: visible;
    }

    .site-nav a {
      align-items: center;
      display: inline-flex;
      font-size: 0.92rem;
    }
  }
</style>

<script>
  import { setupMobileMenu } from "../scripts/mobile-menu";
  import { setupContactLinks } from "../scripts/contact-links";

  setupMobileMenu();
  setupContactLinks();
</script>
